# Copy to .env. Only the key is required - the rest default to the public testnet.

# Your account: a BIP-39 mnemonic or a 32-byte hex seed, one or the other.
# `npm run account:new` prints a matching pair for a fresh account.
BKC_MNEMONIC=
BKC_SEED=

# The node to deploy through.
BKC_EVM_RPC=
BKC_COSMOS_RPC=

# Block explorer, for `npm run verify`.
BKC_EXPLORER=
