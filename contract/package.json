{
  "name": "bkc-dapp-starter-contract",
  "version": "1.0.0",
  "private": true,
  "description": "The contract half of the BKC dApp starter: ordinary Hardhat, signing with ML-DSA-65",
  "license": "MIT",
  "scripts": {
    "account:new": "node scripts/new-account.js",
    "account": "hardhat bkc-account --network bkc",
    "doctor": "hardhat bkc-doctor --network bkc",
    "compile": "hardhat compile",
    "test": "hardhat test --network bkc",
    "deploy": "hardhat run scripts/deploy.js --network bkc",
    "verify": "node scripts/verify.js"
  },
  "devDependencies": {
    "@bkc-network-lib/crypto": "^1.0.0",
    "@bkc-network-lib/hardhat": "^1.0.0",
    "@bkc-network-lib/sdk": "^1.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "dotenv": "^18.0.3",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1"
  }
}
